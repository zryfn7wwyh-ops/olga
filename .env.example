# ───────── Сайт ─────────
# Название бренда (по умолчанию — рабочее «Legal Performance»)
NEXT_PUBLIC_SITE_NAME=
# Канонический адрес без завершающего слеша, например https://example.ru
NEXT_PUBLIC_SITE_URL=
# Режим сайта: preview (заглушки с пометкой «ДЕМО / ЗАМЕНИТЬ», noindex) | production (заглушки скрыты, index)
# Сборка production остановится, если не заданы LEAD_DELIVERY_MODE, LEGAL_DOCUMENTS_APPROVED=true и NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_SITE_MODE=preview
# true — тексты политики ПДн и согласия утверждены и опубликованы
LEGAL_DOCUMENTS_APPROVED=false
# Внешние ссылки на документы (если опубликованы не на этом сайте). Пусто — /privacy и /privacy#consent
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_CONSENT_URL=
# OG-обложка для production (путь в /public или URL), 1200×630
NEXT_PUBLIC_OG_IMAGE=
# Путь размещения: пусто — корень домена; "/marketing-dlya-yuristov" — при встраивании в существующий сайт
BASE_PATH=

# ───────── Контакты (пустые значения не выводятся) ─────────
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_MESSENGER_URL=
NEXT_PUBLIC_CONTACT_MESSENGER_LABEL=
# Оператор ПДн / реквизиты для подвала
NEXT_PUBLIC_LEGAL_ENTITY=

# ───────── Аналитика ─────────
# ID счётчика Яндекс Метрики (только цифры). Пусто — счётчик не подключается.
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# ───────── Доставка заявок ─────────
# webhook | bitrix24 | telegram | demo  (можно несколько через запятую: bitrix24,telegram)
# Пусто: в preview — демо («Демо: заявка не отправлена»), в production — отправка недоступна (503).
LEAD_DELIVERY_MODE=

# webhook: POST JSON {type:"lead", lead:{...}}
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# bitrix24: входящий вебхук с правом crm, например https://company.bitrix24.ru/rest/1/xxxxxxxx
BITRIX24_WEBHOOK_URL=
BITRIX24_SOURCE_ID=WEB

# telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
