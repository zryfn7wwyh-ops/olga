# Публичный адрес сайта (canonical, Open Graph, sitemap). Утверждается заказчиком.
NEXT_PUBLIC_SITE_URL=https://example.ru

# Канал доставки заявок: webhook | test
#   webhook — POST JSON на LEAD_WEBHOOK_URL (CRM, интеграционная платформа, собственный backend).
#   test    — запись в локальный файл LEAD_TEST_FILE. Только для разработки и приёмки.
# Если переменная не задана: в dev используется test, в production форма отвечает 503 (заявки не принимаются).
LEAD_DELIVERY_MODE=webhook
LEAD_WEBHOOK_URL=
# Секрет передаётся в заголовке Authorization: Bearer <секрет>. Хранится только на сервере.
LEAD_WEBHOOK_SECRET=
LEAD_WEBHOOK_TIMEOUT_MS=8000

# Тестовый режим
LEAD_TEST_FILE=.data/leads.jsonl
# Разрешить тестовый режим в production-сборке (только для закрытой приёмки, не для публичного релиза).
LEAD_ALLOW_TEST_MODE_IN_PRODUCTION=false

# Ограничение частоты: не более N заявок с одного IP за окно (мс).
LEAD_RATE_LIMIT_MAX=5
LEAD_RATE_LIMIT_WINDOW_MS=600000
