# Публичный URL сайта (используется в metadata, OpenGraph, sitemap, canonical)
NEXT_PUBLIC_SITE_URL=https://example.com

# ID счетчика Яндекс.Метрики. Если пусто — счетчик и события не подключаются.
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Ссылки на юридические документы (используются в форме и футере).
# Документы размещены вне этого проекта — указать полный URL.
NEXT_PUBLIC_PRIVACY_POLICY_URL=
NEXT_PUBLIC_PERSONAL_DATA_CONSENT_URL=
NEXT_PUBLIC_ADVERTISING_CONSENT_URL=
